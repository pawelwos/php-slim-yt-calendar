APP_ENV=development
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Warsaw
APP_LOCALE=pl_PL

# Google OAuth2 credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must be: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of Google accounts allowed to log in
ALLOWED_EMAILS=you@gmail.com,colleague@example.com

# SQLite database file (relative to project root)
DB_PATH=storage/youtube.db

# YouTube sync (cron/sync-youtube.php)
# Value written to the `source` column for newly added videos
YOUTUBE_SOURCE=pawel
# Refresh token created by: php cron/authorize-youtube.php
YOUTUBE_TOKEN_PATH=storage/youtube-token.json
