{# Expects: cal, navigation (bool) #}
<section aria-label="Kalendarz" class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-900/5 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        {% if navigation %}
        <div class="flex items-center gap-1">
            <a href="{{ cal.prevYearUrl }}" class="rounded-md px-2 py-1 text-sm text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50" aria-label="Poprzedni rok">«</a>
            <a href="{{ cal.prevMonthUrl }}" class="rounded-md px-2 py-1 text-sm text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50" aria-label="Poprzedni miesiąc">‹</a>
        </div>
        {% endif %}
        <div class="text-center">
            <h2 class="text-xl font-semibold tracking-tight">{{ cal.title|capitalize }}</h2>
            <p class="text-xs text-slate-500">W tym miesiącu: {{ cal.total }} {{ plural(cal.total, 'film', 'filmy', 'filmów') }}</p>
        </div>
        {% if navigation %}
        <div class="flex items-center gap-1">
            <a href="{{ cal.nextMonthUrl }}" class="rounded-md px-2 py-1 text-sm text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50" aria-label="Następny miesiąc">›</a>
            <a href="{{ cal.nextYearUrl }}" class="rounded-md px-2 py-1 text-sm text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50" aria-label="Następny rok">»</a>
        </div>
        {% endif %}
    </div>

    {% if navigation %}
    <div class="mt-4 flex flex-wrap justify-center gap-1" role="group" aria-label="Miesiąc">
        {% for m in cal.months %}
        <a href="/calendar/{{ cal.year }}/{{ m.n }}"
           {% if m.active %}aria-current="true"{% endif %}
           class="rounded-md px-2.5 py-1 text-xs font-medium {{ m.active ? 'bg-indigo-600 text-white' : 'text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50' }}">
            {{ m.label }}
        </a>
        {% endfor %}
        <a href="/calendar" class="ml-2 rounded-md px-2.5 py-1 text-xs font-medium text-indigo-700 ring-1 ring-indigo-200 hover:bg-indigo-50">Dziś</a>
    </div>
    {% endif %}

    <div class="mt-5 grid grid-cols-7 gap-1 text-center text-xs font-medium uppercase tracking-wide text-slate-400">
        {% for d in cal.weekdays %}<div>{{ d }}</div>{% endfor %}
    </div>
    <div class="mt-1 grid grid-cols-7 gap-1">
        {% for week in cal.weeks %}{% for c in week %}
            {% if c is null %}
            <div></div>
            {% else %}
            <a href="{{ c.url }}"
               {% if c.isSelected %}aria-current="date"{% endif %}
               class="relative flex aspect-square flex-col items-center justify-center rounded-lg text-sm transition
                      {{ c.isSelected ? 'bg-indigo-600 text-white shadow' : (c.isToday ? 'bg-indigo-50 font-semibold text-indigo-700 ring-1 ring-indigo-300' : 'text-slate-700 hover:bg-slate-100') }}"
               title="{{ c.count }} {{ plural(c.count, 'film', 'filmy', 'filmów') }}">
                <span>{{ c.day }}</span>
                {% if c.count > 0 %}
                <span class="mt-0.5 min-w-5 rounded-full px-1.5 text-[10px] leading-4 font-semibold {{ c.isSelected ? 'bg-white/25 text-white' : 'bg-red-100 text-red-700' }}">{{ c.count }}</span>
                {% endif %}
            </a>
            {% endif %}
        {% endfor %}{% endfor %}
    </div>
</section>
