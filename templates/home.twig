{% extends 'layout.twig' %}
{% block title %}Strona główna · YT Kalendarz{% endblock %}

{% block body %}
<main class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-semibold tracking-tight">Witaj, {{ user.name ?: user.email }} 👋</h1>
    <div class="mt-6 grid gap-8 lg:grid-cols-[22rem_1fr]">
        {% include '_calendar.twig' with {navigation: false} %}
        {% include '_videos.twig' with {heading: "Dzisiaj · " ~ selected|localdate('EEEE, d MMMM y')} %}
    </div>
</main>
{% endblock %}
