{# Expects: videos, heading #}
<section aria-label="Filmy">
    <h2 class="text-lg font-semibold tracking-tight">{{ heading }}</h2>
    {% if videos is empty %}
    <p class="mt-3 rounded-lg border border-dashed border-slate-300 bg-white px-4 py-8 text-center text-sm text-slate-500">Brak filmów z tego dnia.</p>
    {% else %}
    <p class="text-sm text-slate-500">{{ videos|length }} {{ plural(videos|length, 'film', 'filmy', 'filmów') }}</p>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {% for v in videos %}
        <li class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-900/5">
            <iframe class="aspect-video w-full" loading="lazy"
                    src="https://www.youtube-nocookie.com/embed/{{ v.videoId|url_encode }}"
                    title="{{ v.title }}"
                    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                    referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            <div class="flex items-start justify-between gap-2 px-3 py-2">
                <p class="text-sm font-medium break-words">{{ v.title }}</p>
                {% if v.source %}<span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{{ v.source }}</span>{% endif %}
            </div>
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</section>
